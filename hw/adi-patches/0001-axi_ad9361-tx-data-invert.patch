From: GlideLink SDR
Subject: [PATCH] axi_ad9361: per-pair TX LVDS data polarity input

Adds tx_data_invert[5:0] (default 0). Each set bit inverts that TX data
pair, for boards with a P/N swapped pair; synchronised to l_clk.
---
diff --git a/library/axi_ad9361/axi_ad9361.v b/library/axi_ad9361/axi_ad9361.v
index 709e576..3c32689 100644
--- a/library/axi_ad9361/axi_ad9361.v
+++ b/library/axi_ad9361/axi_ad9361.v
@@ -97,6 +97,10 @@ module axi_ad9361 #(
   output  [ 5:0]  tx_data_out_p,
   output  [ 5:0]  tx_data_out_n,
 
+  // transmit-lvds data-pair polarity (1 = pair inverted, e.g. P/N swapped on the board)
+
+  input   [ 5:0]  tx_data_invert,
+
   // physical interface (transmit-cmos)
 
   output          tx_clk_out,
@@ -422,6 +426,7 @@ module axi_ad9361 #(
     .tx_frame_out_n (tx_frame_out_n),
     .tx_data_out_p (tx_data_out_p),
     .tx_data_out_n (tx_data_out_n),
+    .tx_data_invert (tx_data_invert),
     .enable (enable),
     .txnrx (txnrx),
     .rst (rst),
diff --git a/library/axi_ad9361/axi_ad9361_ip.tcl b/library/axi_ad9361/axi_ad9361_ip.tcl
index 1278cf0..56de107 100644
--- a/library/axi_ad9361/axi_ad9361_ip.tcl
+++ b/library/axi_ad9361/axi_ad9361_ip.tcl
@@ -70,6 +70,7 @@ set_property driver_value 0 [ipx::get_ports *dovf* -of_objects [ipx::current_cor
 set_property driver_value 0 [ipx::get_ports *dunf* -of_objects [ipx::current_core]]
 set_property driver_value 0 [ipx::get_ports *gpio_in* -of_objects [ipx::current_core]]
 set_property driver_value 0 [ipx::get_ports *gps_pps* -of_objects [ipx::current_core]]
+set_property driver_value 0 [ipx::get_ports *tx_data_invert* -of_objects [ipx::current_core]]
 
 set_property enablement_dependency {spirit:decode(id('MODELPARAM_VALUE.CMOS_OR_LVDS_N')) == 0} \
   [ipx::get_ports rx_clk_in_p     -of_objects [ipx::current_core]] \
diff --git a/library/axi_ad9361/xilinx/axi_ad9361_lvds_if.v b/library/axi_ad9361/xilinx/axi_ad9361_lvds_if.v
index 6002396..c5c8161 100644
--- a/library/axi_ad9361/xilinx/axi_ad9361_lvds_if.v
+++ b/library/axi_ad9361/xilinx/axi_ad9361_lvds_if.v
@@ -64,6 +64,7 @@ module axi_ad9361_lvds_if #(
   output              tx_frame_out_n,
   output  [ 5:0]      tx_data_out_p,
   output  [ 5:0]      tx_data_out_n,
+  input   [ 5:0]      tx_data_invert,
 
   // ensm control
 
@@ -345,6 +346,16 @@ module axi_ad9361_lvds_if #(
     endcase
   end
 
+  // data-pair polarity (static, asynchronous input)
+
+  (* ASYNC_REG = "TRUE" *) reg [ 5:0] tx_data_invert_m1 = 'd0;
+  (* ASYNC_REG = "TRUE" *) reg [ 5:0] tx_data_invert_s = 'd0;
+
+  always @(posedge l_clk) begin
+    tx_data_invert_m1 <= tx_data_invert;
+    tx_data_invert_s <= tx_data_invert_m1;
+  end
+
   // transfer to local clock
 
   generate if (CLK_DESKEW) begin
@@ -364,8 +375,8 @@ module axi_ad9361_lvds_if #(
     always @(posedge l_clk) begin
       tx_clk <= tx_clk_n;
       tx_frame <= tx_frame_n;
-      tx_data_0 <= tx_data_0_n;
-      tx_data_1 <= tx_data_1_n;
+      tx_data_0 <= tx_data_0_n ^ tx_data_invert_s;
+      tx_data_1 <= tx_data_1_n ^ tx_data_invert_s;
     end
 
   end else begin /* CLK_DESKEW == 0 */
@@ -373,8 +384,8 @@ module axi_ad9361_lvds_if #(
     always @(posedge l_clk) begin
       tx_clk <= tx_clk_p;
       tx_frame <= tx_frame_p;
-      tx_data_0 <= tx_data_0_p;
-      tx_data_1 <= tx_data_1_p;
+      tx_data_0 <= tx_data_0_p ^ tx_data_invert_s;
+      tx_data_1 <= tx_data_1_p ^ tx_data_invert_s;
     end
 
   end
