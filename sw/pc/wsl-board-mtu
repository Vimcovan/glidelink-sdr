#!/bin/bash
# WSL (mirrored networking): MTU 1500 on the network interfaces that reach the boards.
# The boards' USB network links use jumbo frames (MTU 9000, os/board/install_net.sh) and the
# mirrored interfaces show 9000, but frames above 1500 bytes do not pass between Windows and
# WSL; with 9000 the connections from WSL to a board stall (docs/known_issues.md 1.3).
#     sudo bash wsl-board-mtu
for dev in $(ip -o -4 addr show | awk '$4 ~ /^192\.168\.[34]\./ { print $2 }' | sort -u); do
    ip link set "$dev" mtu 1500 && echo "$dev: MTU 1500"
done
