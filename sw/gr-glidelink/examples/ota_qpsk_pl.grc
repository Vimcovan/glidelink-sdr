  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 460.0]
    rotation: 0
    state: enabled
- name: clock
  id: digital_pfb_clock_sync_xxx
  parameters:
    affinity: pcores
    alias: ''
    comment: "on the performance cores (variable pcores); \nmax_dev 0.05: the two\
      \ boards' clocks differ by at most 200 ppm (rate 0.0004 at 2 samples per symbol);\
      \ \n1.5 let the loop settle at the bound (false lock)"
    filter_size: '32'
    init_phase: '16'
    loop_bw: 6.28 / 200
    max_dev: '0.05'
    maxoutbuf: '0'
    minoutbuf: '0'
    osps: '1'
    sps: rx_sps
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 704.0]
    rotation: 0
    state: enabled
- name: costas
