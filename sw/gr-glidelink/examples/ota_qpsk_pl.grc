connections:
- [agc, '0', before, '0']
- [agc, '0', fll, '0']
- [bits, '0', unpack, '0']
- [clock, '0', costas, '0']
- [costas, '0', after, '0']
- [fll, '0', clock, '0']
- [rx, '0', agc, '0']
- [rx, '0', spectrum, '0']
- [rx, '0', waterfall, '0']
- [rx_fir, '0', rx, '0']
- [rx_radio, '0', rx_fir, '0']
- [scale, '0', tx, '0']
- [symbols, '0', scale, '0']
- [tx, '0', tx_fir, '0']
- [tx_fir, '0', tx_radio, '0']
- [unpack, '0', symbols, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
