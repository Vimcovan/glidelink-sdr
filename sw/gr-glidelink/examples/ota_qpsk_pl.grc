    filter_size: '44'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: '0.35'
    samps_per_sym: rx_sps
    type: cc
    w: 6.28 / 400
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 696.0]
    rotation: 0
    state: enabled
