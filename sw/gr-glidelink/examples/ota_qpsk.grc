options:
  parameters:
    author: GlideLink
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: QPSK from the TX board (GlideLink Sink) to the RX board (GlideLink Source), FLL + clock sync + Costas
    generate_options: qt_gui
    id: glidelink_ota_qpsk
    output_language: python
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    title: GlideLink OTA QPSK
    window_size: (1400,900)
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.5e6
  states:
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    coordinate: [300, 8]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    coordinate: [400, 8]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_qpsk().base()
  states:
    coordinate: [480, 8]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(32, 32 * sps, 1.0, 0.35, 11 * sps * 32)
  states:
    coordinate: [680, 8]
    rotation: 0
    state: enabled
- name: tx_atten
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: TX attenuation (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [200, 90]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '71'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [400, 90]
    rotation: 0
    state: enabled
- name: bits
  id: analog_random_source_x
  parameters:
    comment: ''
    max: '256'
    min: '0'
    num_samps: '10000'
    repeat: 'True'
    type: byte
  states:
    coordinate: [8, 250]
    rotation: 0
    state: enabled
- name: mod
  id: digital_constellation_modulator
  parameters:
    comment: ''
    constellation: qpsk
    differential: 'False'
    excess_bw: '0.35'
    log: 'False'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    coordinate: [200, 250]
    rotation: 0
    state: enabled
- name: scale
  id: blocks_multiply_const_vxx
  parameters:
    comment: ''
    const: '0.5'
    type: complex
    vlen: '1'
  states:
    coordinate: [420, 260]
    rotation: 0
    state: enabled
- name: tx
  id: glidelink_sink
  parameters:
    address: '192.168.4.1'
    atten: tx_atten
    bandwidth: '0'
    comment: TX board
    freq: freq
    samp_rate: samp_rate
  states:
    coordinate: [560, 240]
    rotation: 0
    state: enabled
- name: rx
  id: glidelink_source
  parameters:
    address: '192.168.3.1'
    bandwidth: '0'
    comment: RX board
    freq: freq
    gain: rx_gain
    gain_mode: '"manual"'
    samp_rate: samp_rate
  states:
    coordinate: [8, 400]
    rotation: 0
    state: enabled
- name: agc
  id: analog_agc_xx
  parameters:
    comment: ''
    gain: '1.0'
    max_gain: '65536'
    rate: 1e-3
    reference: '1.0'
    type: complex
  states:
    coordinate: [240, 400]
    rotation: 0
    state: enabled
- name: fll
  id: digital_fll_band_edge_cc
  parameters:
    comment: ''
    filter_size: '44'
    rolloff: '0.35'
    samps_per_sym: sps
    type: cc
    w: 6.28 / 400
  states:
    coordinate: [420, 400]
    rotation: 0
    state: enabled
- name: clock
  id: digital_pfb_clock_sync_xxx
  parameters:
    comment: ''
    filter_size: '32'
    init_phase: '16'
    loop_bw: 6.28 / 200
    max_dev: '1.5'
    osps: '1'
    sps: sps
    taps: rrc_taps
    type: ccf
  states:
    coordinate: [640, 400]
    rotation: 0
    state: enabled
- name: costas
  id: digital_costas_loop_cc
  parameters:
    comment: ''
    order: '4'
    use_snr: 'False'
    w: 6.28 / 200
  states:
    coordinate: [880, 400]
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    autoscale: 'False'
    bw: samp_rate
    comment: ''
    fc: freq
    fftsize: '2048'
    grid: 'True'
    gui_hint: 1,0,1,1
    name: '"RX spectrum"'
    nconnections: '1'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    coordinate: [240, 520]
    rotation: 0
    state: enabled
- name: waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    bw: samp_rate
    comment: ''
    fc: freq
    fftsize: '1024'
    grid: 'False'
    gui_hint: 1,1,1,1
    name: '"RX waterfall"'
    nconnections: '1'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
  states:
    coordinate: [240, 640]
    rotation: 0
    state: enabled
- name: before
  id: qtgui_const_sink_x
  parameters:
    autoscale: 'False'
    comment: ''
    grid: 'True'
    gui_hint: 2,0,1,1
    name: '"Before sync (AGC output)"'
    nconnections: '1'
    size: '1024'
    type: complex
    update_time: '0.10'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    coordinate: [420, 520]
    rotation: 0
    state: enabled
- name: after
  id: qtgui_const_sink_x
  parameters:
    autoscale: 'False'
    comment: ''
    grid: 'True'
    gui_hint: 2,1,1,1
    name: '"After FLL + clock sync + Costas"'
    nconnections: '1'
    size: '1024'
    type: complex
    update_time: '0.10'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    coordinate: [1080, 400]
    rotation: 0
    state: enabled

connections:
- [bits, '0', mod, '0']
- [mod, '0', scale, '0']
- [scale, '0', tx, '0']
- [rx, '0', spectrum, '0']
- [rx, '0', waterfall, '0']
- [rx, '0', agc, '0']
- [agc, '0', before, '0']
- [agc, '0', fll, '0']
- [fll, '0', clock, '0']
- [clock, '0', costas, '0']
- [costas, '0', after, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
