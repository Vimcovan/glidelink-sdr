options:
  parameters:
    author: GlideLink
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: 'QPSK between the two boards at 20 MSPS (5 Msymbol/s), the whole receiver in the PL
      (qpsk image, hw/images/qpsk.yaml, on both boards): RF -> low-pass and decimation by 2 -> AGC ->
      FLL band-edge -> RRC matched filter -> symbol sync (Gardner) -> Costas loop -> PC, one sample per
      symbol. The TX board''s FIR interpolates the PC''s symbols by 4 with an RRC pulse.'
    generate_options: qt_gui
    id: glidelink_ota_qpsk_plrx
    output_language: python
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    title: GlideLink OTA QPSK (receiver in the PL)
    window_size: (1400,1000)
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: RF sample rate (both boards)
    value: 20e6
  states:
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: 'samples per symbol at the RF rate (4, rrc_interp in the image)'
    value: '4'
  states:
    coordinate: [320, 8]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: 'RX decimation in the PL (2, lp_decim in the image)'
    value: '2'
  states:
    coordinate: [400, 8]
    rotation: 0
    state: enabled
- name: rx_sps
  id: variable
  parameters:
    comment: samples per symbol on the PC (RX)
    value: sps // decim
  states:
    coordinate: [480, 8]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    coordinate: [580, 8]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable
  parameters:
    comment: ''
    value: digital.constellation_qpsk().base()
  states:
    coordinate: [680, 8]
    rotation: 0
    state: enabled
- name: tx_atten
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: TX attenuation (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [200, 160]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '71'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [360, 160]
    rotation: 0
    state: enabled

# ---------------------------------------------------------------- TX board
- name: bits
  id: analog_random_source_x
  parameters:
    comment: ''
    max: '256'
    min: '0'
    num_samps: '10000'
    repeat: 'True'
    type: byte
  states:
    coordinate: [16, 280]
    rotation: 0
    state: enabled
- name: unpack
  id: blocks_packed_to_unpacked_xx
  parameters:
    bits_per_chunk: '2'
    comment: ''
    endianness: gr.GR_MSB_FIRST
    num_ports: '1'
    type: byte
  states:
    coordinate: [200, 280]
    rotation: 0
    state: enabled
- name: symbols
  id: digital_chunks_to_symbols_xx
  parameters:
    comment: ''
    dimension: '1'
    in_type: byte
    num_ports: '1'
    out_type: complex
    symbol_table: qpsk.points()
  states:
    coordinate: [380, 280]
    rotation: 0
    state: enabled
- name: scale
  id: blocks_multiply_const_vxx
  parameters:
    comment: room for the RRC overshoot
    const: '0.4'
    type: complex
    vlen: '1'
  states:
    coordinate: [560, 280]
    rotation: 0
    state: enabled
- name: tx
  id: glidelink_sink
  parameters:
    address: '"192.168.4.1"'
    atten: tx_atten
    bandwidth: '0'
    comment: 'symbols (1 per symbol, samp_rate / sps) into the PL: host0_tx'
    freq: freq
    samp_rate: samp_rate
  states:
    coordinate: [720, 260]
    rotation: 0
    state: enabled
- name: tx_fir
  id: glidelink_rrc_interp
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.4.1"'
    comment: 'RRC pulse, interpolation by 4 (coefficients fixed in the image)'
    slot: '-1'
  states:
    coordinate: [920, 260]
    rotation: 0
    state: enabled
- name: tx_radio
  id: glidelink_radio
  parameters:
    address: '"192.168.4.1"'
    atten: tx_atten
    bandwidth: '0'
    comment: TX board RF
    gain: '0'
    gain_mode: '"manual"'
    rx_freq: freq - 10e6
    samp_rate: samp_rate
    tx_freq: freq
  states:
    coordinate: [1120, 260]
    rotation: 0
    state: enabled

# ---------------------------------------------------------------- RX board
- name: rx_radio
  id: glidelink_radio
  parameters:
    address: '"192.168.3.1"'
    atten: '89'
    bandwidth: '0'
    comment: RX board RF
    gain: rx_gain
    gain_mode: '"slow_attack"'
    rx_freq: freq
    samp_rate: samp_rate
    tx_freq: '0'
  states:
    coordinate: [16, 460]
    rotation: 0
    state: enabled
- name: rx
  id: glidelink_source
  parameters:
    address: '"192.168.3.1"'
    bandwidth: '0'
    comment: 'host0_rx: one sample per symbol (samp_rate / sps) reaches the PC'
    freq: freq
    gain: rx_gain
    gain_mode: '"slow_attack"'
    samp_rate: samp_rate
  states:
    coordinate: [420, 440]
    rotation: 0
    state: enabled
- name: rx_fir
  id: glidelink_lp_decim
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: 'low-pass, decimation by 2 (coefficients fixed in the image)'
    slot: '-1'
  states:
    coordinate: [220, 460]
    rotation: 0
    state: enabled
- name: agc
  id: glidelink_agc
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: ''
    gain: '1.0'
    max_gain: '1000.0'
    rate: 1e-3
    reference: '0.5'
    slot: '-1'
  states:
    coordinate: [420, 460]
    rotation: 0
    state: enabled
- name: fll
  id: glidelink_fll
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: ''
    filter_size: '44'
    rolloff: '0.35'
    slot: '-1'
    sps: rx_sps
    w: 6.28 / 400
  states:
    coordinate: [620, 460]
    rotation: 0
    state: enabled
- name: mf
  id: glidelink_rrc_mf
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: 'RRC matched filter at 2 samples per symbol (fixed in the image)'
    slot: '-1'
  states:
    coordinate: [820, 460]
    rotation: 0
    state: enabled
- name: sym
  id: glidelink_symsync
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: ''
    damping: '0.707'
    loop_bw: '0.01'
    max_dev: '0.01'
    slot: '-1'
    ted_gain: '0.3'
  states:
    coordinate: [1020, 460]
    rotation: 0
    state: enabled
- name: costas
  id: glidelink_costas
  parameters:
    args: '"driver=glidelink,uri=ip:192.168.3.1"'
    comment: ''
    slot: '-1'
    w: 6.28 / 200
  states:
    coordinate: [1220, 460]
    rotation: 0
    state: enabled
- name: fll_freq
  id: variable_function_probe
  parameters:
    block_id: fll
    comment: FLL frequency register, read once a second
    function_args: '''FREQ'''
    function_name: read
    poll_rate: '1'
    value: '0'
  states:
    coordinate: [16, 640]
    rotation: 0
    state: enabled
- name: sym_w
  id: variable_function_probe
  parameters:
    block_id: sym
    comment: ''
    function_args: '''W'''
    function_name: read
    poll_rate: '1'
    value: 2**23
  states:
    coordinate: [200, 640]
    rotation: 0
    state: enabled
- name: costas_freq
  id: variable_function_probe
  parameters:
    block_id: costas
    comment: ''
    function_args: '''FREQ'''
    function_name: read
    poll_rate: '1'
    value: '0'
  states:
    coordinate: [380, 640]
    rotation: 0
    state: enabled
- name: fll_khz
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,0,1,1
    label: FLL frequency correction (kHz)
    type: real
    value: '((fll_freq - 2**32) if fll_freq >= 2**31 else fll_freq) / 2**32 * samp_rate / decim / 1e3'
  states:
    coordinate: [16, 720]
    rotation: 0
    state: enabled
- name: sym_ppm
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,1,1,1
    label: Symbol clock vs nominal (ppm, instantaneous)
    type: real
    value: (sym_w / 2**23 - 1) * 1e6
  states:
    coordinate: [200, 720]
    rotation: 0
    state: enabled
- name: costas_hz
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 2,0,1,1
    label: Costas residual frequency (Hz)
    type: real
    value: '((costas_freq - 2**32) if costas_freq >= 2**31 else costas_freq) / 2**32 * samp_rate / sps'
  states:
    coordinate: [380, 720]
    rotation: 0
    state: enabled
- name: after
  id: qtgui_const_sink_x
  parameters:
    comment: ''
    grid: 'True'
    gui_hint: 3,0,2,2
    name: '"Symbols from the PL receiver (AGC, FLL, matched filter, symbol sync, Costas)"'
    nconnections: '1'
    size: '2048'
    type: complex
    update_time: '0.10'
    xmax: '1'
    xmin: '-1'
    ymax: '1'
    ymin: '-1'
  states:
    coordinate: [620, 600]
    rotation: 0
    state: enabled

connections:
- [bits, '0', unpack, '0']
- [unpack, '0', symbols, '0']
- [symbols, '0', scale, '0']
- [scale, '0', tx, '0']
- [tx, '0', tx_fir, '0']
- [tx_fir, '0', tx_radio, '0']
- [rx_radio, '0', rx_fir, '0']
- [rx_fir, '0', agc, '0']
- [agc, '0', fll, '0']
- [fll, '0', mf, '0']
- [mf, '0', sym, '0']
- [sym, '0', costas, '0']
- [costas, '0', rx, '0']
- [rx, '0', after, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
