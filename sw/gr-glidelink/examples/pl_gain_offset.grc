options:
  parameters:
    author: GlideLink
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'The tutorial module (hw/modules/gain_offset, docs/module_guide.md
      5) in a PL chain: RF -> NCO -> Gain and offset -> host port 1. Gain and the
      DC offset change while it runs; the offset shows as a step of I / Q and a line
      at 0 Hz. Needs the tutorial image.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: glidelink_pl_gain_offset
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: GlideLink PL gain and offset
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: args
  id: variable
  parameters:
    comment: ''
    value: '"driver=glidelink,uri=ip:" + board'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 8]
    rotation: 0
    state: enabled
- name: board
  id: variable
  parameters:
    comment: board with the tutorial image (python glidelink.py build gain_offset
      nco --name tutorial)
    value: '"192.168.3.1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 8]
    rotation: 0
    state: enabled
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: PL gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-2'
    step: '0.01'
    stop: '1.99'
    value: '1'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 176.0]
    rotation: 0
    state: enabled
- name: nco_freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: PL NCO shift (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: -samp_rate / 2
    step: 10e3
    stop: samp_rate / 2
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 176]
    rotation: 0
    state: enabled
- name: offset_i
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: PL offset I
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-0.9'
    step: '0.01'
    stop: '0.9'
    value: '0.3'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 176.0]
    rotation: 0
    state: enabled
- name: offset_q
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
    label: PL offset Q
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-0.9'
    step: '0.01'
    stop: '0.9'
    value: '-0.2'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [936, 160.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 5e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 12.0]
    rotation: 0
    state: enabled
- name: gain_offset
  id: glidelink_gain_offset
  parameters:
    affinity: ''
    alias: ''
    args: args
    comment: generated from hw/modules/gain_offset/module.yaml
    gain: gain
    maxoutbuf: '0'
    minoutbuf: '0'
    offset_i: offset_i
    offset_q: offset_q
    slot: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 520.0]
    rotation: 0
    state: enabled
- name: host
  id: glidelink_host_source
  parameters:
    affinity: ''
    alias: ''
    args: args
    buffer_length: '65536'
    comment: ''
    headers: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 380.0]
    rotation: 0
    state: enabled
- name: nco
  id: glidelink_nco
  parameters:
    affinity: ''
    alias: ''
    args: args
    comment: ''
    freq: nco_freq
    maxoutbuf: '0'
    minoutbuf: '0'
    phase: '0'
    samp_rate: samp_rate
    slot: '-1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 376]
    rotation: 0
    state: enabled
- name: radio
  id: glidelink_radio
  parameters:
    address: board
    affinity: ''
    alias: ''
    atten: '89'
    bandwidth: '0'
    comment: ''
    gain: '40'
    gain_mode: '"manual"'
    maxoutbuf: '0'
    minoutbuf: '0'
    rx_freq: 915e6
    samp_rate: samp_rate
    tx_freq: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 376]
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 6,0,4,2
    label: Relative Gain
    label1: ''
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Spectrum"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 492.0]
    rotation: 0
    state: enabled
- name: time
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'False'
    grid: 'True'
    gui_hint: 2,0,4,2
    label1: I
    label10: Signal 10
    label2: Q
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"After the PL chain"'
    nconnections: '1'
    size: '2000'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 348.0]
    rotation: 0
    state: enabled

connections:
- [gain_offset, '0', host, '0']
- [host, '0', spectrum, '0']
- [host, '0', time, '0']
- [nco, '0', gain_offset, '0']
- [radio, '0', nco, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
