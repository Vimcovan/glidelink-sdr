options:
  parameters:
    author: GlideLink
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: Fast AGC lock level changed at run time; the AD9361 is re-initialised and register 0x101 read back
    generate_options: qt_gui
    id: agc_fast_attack
    output_language: python
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    title: GlideLink fast AGC
    window_size: (1000,1000)
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: uri
  id: parameter
  parameters:
    comment: 'libiio context of the board: ip:192.168.3.1 RX board, ip:192.168.4.1 TX board, local: on the board'
    label: Board
    short_id: u
    type: str
    value: ip:192.168.3.1
  states:
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 2.5e6
  states:
    coordinate: [350, 8]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    coordinate: [450, 8]
    rotation: 0
    state: enabled
- name: lock_level
  id: variable_qtgui_range
  parameters:
    comment: fast AGC lock level, dB below full scale
    gui_hint: 0,0,1,1
    label: Lock level (dBFS below full scale)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '5'
    step: '1'
    stop: '30'
    value: '10'
    widget: counter_slider
  states:
    coordinate: [200, 100]
    rotation: 0
    state: enabled
- name: reg101
  id: variable_function_probe
  parameters:
    block_id: ctl
    comment: AD9361 register 0x101 (AGC lock level) read through the control block
    function_args: '''AD9361:0x101'''
    function_name: read
    poll_rate: '2'
    value: '0'
  states:
    coordinate: [400, 100]
    rotation: 0
    state: enabled
- name: reg101_label
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: str(x & 0x7f)'
    gui_hint: 0,1,1,1
    label: Register 0x101 [6:0]
    type: int
    value: reg101
  states:
    coordinate: [600, 100]
    rotation: 0
    state: enabled
- name: ctl
  id: glidelink_control
  parameters:
    args: '''driver=glidelink,uri='' + uri'
    comment: writes the fast-AGC parameters and re-initialises the AD9361 whenever lock_level changes
    interval: '1.0'
    readback: '[''AD9361:0x101'', ''gain_control_mode'']'
    registers: '{}'
    routes: '{}'
    settings: '{''gain_control_mode'': ''fast_attack'', ''adi,agc-inner-thresh-high'': str(lock_level), ''initialize'': True}'
  states:
    coordinate: [200, 220]
    rotation: 0
    state: enabled
- name: msg_debug
  id: blocks_message_debug
  parameters:
    comment: prints the control block's read-back
    en_uvec: 'True'
    log_level: info
  states:
    coordinate: [520, 230]
    rotation: 0
    state: enabled
- name: src
  id: soapy_custom_source
  parameters:
    agc0: 'True'
    antenna0: A_BALANCED
    bandwidth0: samp_rate
    center_freq0: freq
    comment: ''
    dc_offset0: '0'
    dc_removal0: 'False'
    dev_args: '''uri='' + uri'
    driver: glidelink
    freq_correction0: '0'
    gain0: '0'
    iq_balance0: '0'
    nchan: '1'
    samp_rate: samp_rate
    settings0: ''
    stream_args: ''
    tune_args0: ''
    type: fc32
  states:
    coordinate: [200, 350]
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    fc: freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 1,0,1,2
    label: Relative Gain
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '""'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    coordinate: [520, 350]
    rotation: 0
    state: enabled
- name: level
  id: qtgui_time_sink_x
  parameters:
    autoscale: 'False'
    axislabels: 'True'
    comment: magnitude of the received samples (the AGC holds the lock level)
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 2,0,1,2
    legend: 'False'
    name: '"|x|"'
    nconnections: '1'
    size: '25000'
    srate: samp_rate
    stemplot: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    ylabel: Amplitude
    ymax: '1'
    ymin: '0'
    yunit: '""'
  states:
    coordinate: [720, 450]
    rotation: 0
    state: enabled
- name: mag
  id: blocks_complex_to_mag
  parameters:
    comment: ''
    vlen: '1'
  states:
    coordinate: [520, 470]
    rotation: 0
    state: enabled

connections:
- [ctl, status, msg_debug, print]
- [src, '0', spectrum, '0']
- [src, '0', mag, '0']
- [mag, '0', level, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
